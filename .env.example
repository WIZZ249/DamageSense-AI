# Copy this file to .env and fill in your values
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///damagesense.db
MAX_UPLOAD_MB=16

# Optional: local TFLite damage model (see models/README.md). Leave unset to
# use Roboflow (below) or the built-in heuristic fallback instead.
DAMAGE_TFLITE_MODEL_PATH=
DAMAGE_TFLITE_LABELS_PATH=models/labels.txt
DAMAGE_TFLITE_CONFIDENCE=0.35

# Optional: professional hosted damage-assessment model.
# Train or choose a Roboflow model for structural/building damage detection,
# then set these values in Render environment variables.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE=35
ROBOFLOW_OVERLAP=30

# Optional: provision one administrator at startup without storing credentials in code.
# Add the real values in Render's Environment settings, never in GitHub.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true only when intentionally rotating the configured admin password.
ADMIN_RESET_PASSWORD=false

# Optional: transactional registration and password-reset email delivery.
# Use a verified sender/domain and a SendGrid key with Mail Send permission.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=DamageSense AI
