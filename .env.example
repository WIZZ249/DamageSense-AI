# Copy this file to .env and fill in your values
FLASK_ENV=development
FLASK_SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///damagesense.db
MAX_UPLOAD_MB=16

# Optional: professional hosted damage-assessment model.
# Train or choose a Roboflow model for structural/building damage detection,
# then set these values in Render environment variables.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE=35
ROBOFLOW_OVERLAP=30
